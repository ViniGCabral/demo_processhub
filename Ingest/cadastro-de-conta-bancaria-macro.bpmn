          <dc:Bounds x="148" y="223" width="115" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_act_receber" bpmnElement="act_receber">
        <dc:Bounds x="286" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
